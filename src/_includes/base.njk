<!doctype html>
<html lang="pl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{{ title }}</title>
<meta name="description" content="{{ description }}">
<link rel="icon" href="favicon.ico" sizes="48x48">
<link rel="icon" type="image/png" sizes="32x32" href="favicon-32.png">
<link rel="apple-touch-icon" href="apple-touch-icon.png">
<link rel="manifest" href="site.webmanifest">
<meta name="theme-color" content="#0B1626">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description }}">
<meta property="og:image" content="{{ baseUrl }}/brand/og.jpg">
<meta property="og:locale" content="pl_PL">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700&family=Geist:wght@400;500;600&display=swap">
<link rel="stylesheet" href="style.css">
</head>
<body>
{%- set h = "" if home else "index.html" %}

<header class="nav" id="nav">
  <div class="wrap nav-in">
    <a class="brand" href="{{ '#top' if home else 'index.html' }}" aria-label="Qmala, początek strony">
      <img src="brand/q-96.png" alt="" width="40" height="40">
      <span><b>Qmala<i>.pl</i></b><small>Elektroinstalacje</small></span>
    </a>
    <nav class="nav-links" id="nav-links" aria-label="Główna">
      <a href="oferta.html"{% if nav == "oferta" %} aria-current="page"{% endif %}>Oferta</a>
      <a href="realizacje.html"{% if nav == "realizacje" %} aria-current="page"{% endif %}>Realizacje</a>
      <a href="referencje.html"{% if nav == "referencje" %} aria-current="page"{% endif %}>Referencje</a>
      <a href="o-firmie.html"{% if nav == "firma" %} aria-current="page"{% endif %}>Firma</a>
      {%- if praca.widoczna %}
      <a href="praca.html"{% if nav == "praca" %} aria-current="page"{% endif %}>Zatrudniamy</a>
      {%- endif %}
      <a href="{{ h }}#kontakt">Kontakt</a>
    </nav>
    <a class="btn btn-primary nav-call" href="{{ site.telefon | tel }}">
      {% include "ico-phone.njk" %}
      Zadzwoń <span class="num">{{ site.telefon }}</span>
    </a>
    <button class="nav-toggle" id="nav-toggle" type="button" aria-expanded="false" aria-controls="nav-links">Menu</button>
  </div>
</header>

<main id="top">
{{ content | safe }}
</main>

<footer class="foot">
  <div class="wrap">
    <div class="foot-logo"><img src="brand/logo-dark.png" alt="QMALA.PL Elektroinstalacje" width="760" height="206" loading="lazy"></div>
    <div><b>{{ site.nazwa }}</b>NIP {{ site.nip }}<br>REGON {{ site.regon }}</div>
    <div><b>Siedziba</b>{{ site.siedziba_ulica }}<br>{{ site.siedziba_miasto }}<br><a href="https://www.google.com/maps/search/?api=1&query={{ (site.siedziba_ulica + ', ' + site.siedziba_miasto) | urlencode }}" target="_blank" rel="noopener">Pokaż na mapie</a></div>
    <div><b>Korespondencja</b>{{ site.korespondencja_ulica }}<br>{{ site.korespondencja_miasto }}</div>
    <div class="links"><b>Więcej</b>
      <a href="o-firmie.html">O firmie</a>
      {%- if praca.widoczna %}
      <a href="praca.html">Zatrudniamy</a>
      {%- endif %}
      {%- if site.facebook %}
      <a href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a>
      {%- endif %}
      {%- if site.instagram %}
      <a href="{{ site.instagram }}" target="_blank" rel="noopener">Instagram</a>
      {%- endif %}
      <span>© {{ teraz }} Qmala</span>
    </div>
  </div>
</footer>

<div class="dock" id="dock">
  <a class="btn btn-primary" href="{{ site.telefon | tel }}">Zadzwoń</a>
  <a class="btn btn-ghost" href="{{ h }}#wycena">Wycena</a>
</div>

<script src="site.js"></script>
</body>
</html>
